# Real CoT pulled from a server never enters git (personal data); only the synthetic fixture does
data/*
!data/synthetic.json

# Basemaps are carried, not committed
maps/
*.mbtiles

# Build output and tool caches
dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Machine-specific Claude Code settings (generated by the workspace generator)
.claude/settings.local.json

.DS_Store

# machine-specific preview config, never tracked
.claude/launch.json
